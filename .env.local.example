# backend-notification — local (LocalStack)
# Copiar a .env.local (no se versiona).
PORT=3001
NODE_ENV=local
AWS_REGION=us-east-1
# LocalStack: el AWS SDK usa este endpoint para todos los servicios
AWS_LOCAL=true
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# notification lee REGION (no AWS_REGION)
REGION=us-east-1
SES_SOURCE_EMAIL=no-reply@foodstore.local
