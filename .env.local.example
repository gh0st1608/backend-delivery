# backend-auth — local (LocalStack)
# Copiar a .env.local (no se versiona).
PORT=3000
NODE_ENV=local
AWS_REGION=us-east-1
# LocalStack: el AWS SDK usa este endpoint para todos los servicios
AWS_LOCAL=true
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=foodstore-events

# Clave pública RS256 de backend-auth (PEM entre comillas dobles, multilínea o con 
)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=foodstore-auth
JWT_AUDIENCE=foodstore-api
INTERNAL_API_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_FAMILY_MAX_SECONDS=2592000
REFRESH_TOKEN_TABLE=RefreshTokens
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
