# backend-payment — local (LocalStack)
# Copiar a .env.local (no se versiona).
PORT=3005
NODE_ENV=local
AWS_REGION=us-east-1
# LocalStack: el AWS SDK usa este endpoint para todos los servicios
AWS_LOCAL=true
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=foodstore-events

# Credenciales sandbox: developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# URL base de backend-order (incluye /order). Se reenvía el token del usuario.
ORDER_MS_BASE_URL=http://localhost:3004/order
# Prefijos permitidos para successUrl/cancelUrl (web, Expo Go y development build)
PAYMENT_ALLOWED_RETURN_URLS=http://localhost:8081/,exp://,frontenddelivery://

# Clave pública RS256 de backend-auth (PEM entre comillas dobles, multilínea o con 
)
JWT_PUBLIC_KEY=
JWT_ISSUER=foodstore-auth
JWT_AUDIENCE=foodstore-api
INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
