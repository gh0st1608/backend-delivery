# backend-order — local (LocalStack)
# Copiar a .env.local (no se versiona).
PORT=3004
NODE_ENV=local
AWS_REGION=us-east-1
# LocalStack: el AWS SDK usa este endpoint para todos los servicios
AWS_LOCAL=true
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=foodstore-events
ORDER_TABLE=Orders
SETTINGS_TABLE=Settings
SHOP_MS_BASE_URL=http://localhost:3002/shop
# Cola SQS suscrita a PaymentApproved (la consume el poller local)
ORDER_EVENTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/foodstore-order-events
EXCHANGE_RATE_API_URL=https://mindicador.cl/api/dolar

# Valores por defecto si la tabla Settings no tiene el parámetro
DEFAULT_DELIVERY_FEE_CLP=1990
DEFAULT_USD_CLP_RATE=950
EXCHANGE_RATE_CACHE_TTL_SECONDS=3600
COURIER_MAX_LOCATION_AGE_SECONDS=120
COURIER_AUTO_ASSIGN_MAX_CANDIDATES=25
COURIER_MAX_PICKUP_DISTANCE_KM=10
COURIER_ASSIGN_RETRY_INTERVAL_SECONDS=30
COURIER_ASSIGN_MAX_ATTEMPTS=20

# Clave pública RS256 de backend-auth (PEM entre comillas dobles, multilínea o con 
)
JWT_PUBLIC_KEY=
JWT_ISSUER=foodstore-auth
JWT_AUDIENCE=foodstore-api
INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
