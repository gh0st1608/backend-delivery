PORT=${PORT}
NODE_ENV=${NODE_ENV}
AWS_REGION=${AWS_REGION}
AWS_LOCAL=${AWS_LOCAL}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
EVENT_BUS_NAME=${EVENT_BUS_NAME}

# JWT RS256: solo auth tiene la clave privada. PEM en una línea con \n escapados.
JWT_PRIVATE_KEY=${JWT_PRIVATE_KEY}
JWT_PUBLIC_KEY=${JWT_PUBLIC_KEY}
JWT_ISSUER=foodstore-auth
JWT_AUDIENCE=foodstore-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_FAMILY_MAX_SECONDS=2592000
REFRESH_TOKEN_TABLE=RefreshTokens
# En producción: true / strict (o none si la web y la API están en dominios distintos)
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict

INTERNAL_API_KEY=${INTERNAL_API_KEY}
CORS_ORIGINS=${CORS_ORIGINS}
