# backend-payment — producción (AWS)
# Copiar a .env.production (no se versiona).
PORT=${PORT}
NODE_ENV=production
AWS_REGION=us-east-1
# En Lambda se usan las credenciales del rol; estas solo para ejecutar en local contra AWS
AWS_LOCAL=false
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
EVENT_BUS_NAME=foodstore-events

PAYPAL_CLIENT_ID=${PAYPAL_CLIENT_ID}
PAYPAL_CLIENT_SECRET=${PAYPAL_CLIENT_SECRET}
PAYPAL_ENV=production

ORDER_MS_BASE_URL=${API_URL}/order
PAYMENT_ALLOWED_RETURN_URLS=${PAYMENT_ALLOWED_RETURN_URLS}

# Clave pública RS256 de backend-auth (PEM entre comillas dobles, multilínea o con 
)
JWT_PUBLIC_KEY=${JWT_PUBLIC_KEY}
JWT_ISSUER=foodstore-auth
JWT_AUDIENCE=foodstore-api
INTERNAL_API_KEY=${INTERNAL_API_KEY}
CORS_ORIGINS=${CORS_ORIGINS}
