# backend-notification — producción (AWS)
# Copiar a .env.production (no se versiona).
PORT=${PORT}
NODE_ENV=production
AWS_REGION=us-east-1
# En Lambda se usan las credenciales del rol; estas solo para ejecutar en local contra AWS
AWS_LOCAL=false
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
# notification lee REGION (no AWS_REGION)
REGION=us-east-1
SES_SOURCE_EMAIL=${SES_SOURCE_EMAIL}
